@model LoginViewModel
@{
    ViewData["Title"] = "Log in";
}

<h1>Log in</h1>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert">
        <div asp-validation-summary="All"></div>
    </div>
}

<form asp-action="Login" method="post" class="col-md-4">
    <input asp-for="ReturnUrl" type="hidden" />
    <div class="mb-3">
        <label asp-for="Username" class="form-label"></label>
        <input asp-for="Username" class="form-control" autocomplete="username" required />
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="current-password" required />
    </div>
    <button type="submit" class="btn btn-success">Log in</button>
    <a asp-action="Register" class="btn btn-link">Create an account</a>
</form>
