@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
    var roles = (string[])ViewBag.Roles;
}

<h1>Register</h1>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert">
        <div asp-validation-summary="All"></div>
    </div>
}

<form asp-action="Register" method="post" class="col-md-4">
    <div class="mb-3">
        <label asp-for="Username" class="form-label"></label>
        <input asp-for="Username" class="form-control" autocomplete="username" required />
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" required />
    </div>
    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" required />
    </div>
    <div class="mb-3">
        <label asp-for="Role" class="form-label"></label>
        <select asp-for="Role" asp-items="@(new SelectList(roles))" class="form-select"></select>
    </div>
    <button type="submit" class="btn btn-success">Register</button>
    <a asp-action="Login" class="btn btn-link">Already have an account?</a>
</form>
